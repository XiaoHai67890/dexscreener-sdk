# Entity: token

main: kit: entity: token: {

  alias: field: {}

  fields: {
    baseToken: {
      h: "Base Token"
      n: "baseToken"
      r: false
      t: "`$OBJECT`"
    }
    boosts: {
      h: "Boosts"
      n: "boosts"
      r: false
      t: "`$OBJECT`"
    }
    chainId: {
      h: "Chain Id"
      n: "chainId"
      r: false
      t: "`$STRING`"
    }
    dexId: {
      h: "Dex Id"
      n: "dexId"
      r: false
      t: "`$STRING`"
    }
    fdv: {
      h: "Fdv"
      n: "fdv"
      r: false
      t: "`$NUMBER`"
    }
    info: {
      h: "Info"
      n: "info"
      r: false
      t: "`$OBJECT`"
    }
    labels: {
      h: "Labels"
      n: "labels"
      r: false
      t: "`$ARRAY`"
    }
    liquidity: {
      h: "Liquidity"
      n: "liquidity"
      r: false
      t: "`$OBJECT`"
    }
    marketCap: {
      h: "Market Cap"
      n: "marketCap"
      r: false
      t: "`$NUMBER`"
    }
    pairAddress: {
      h: "Pair Address"
      n: "pairAddress"
      r: false
      t: "`$STRING`"
    }
    pairCreatedAt: {
      h: "Pair Created At"
      n: "pairCreatedAt"
      r: false
      t: "`$INTEGER`"
    }
    priceChange: {
      h: "Price Change"
      n: "priceChange"
      r: false
      t: "`$OBJECT`"
    }
    priceNative: {
      h: "Price Native"
      n: "priceNative"
      r: false
