    }
    priceUsd: {
      h: "Price Usd"
      n: "priceUsd"
      r: false
      t: "`$STRING`"
    }
    quoteToken: {
      h: "Quote Token"
      n: "quoteToken"
      r: false
      t: "`$OBJECT`"
    }
    txns: {
      h: "Txns"
      n: "txns"
      r: false
      t: "`$OBJECT`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: false
      t: "`$STRING`"
    }
    volume: {
      h: "Volume"
      n: "volume"
      r: false
      t: "`$OBJECT`"
    }
  }

  name: "token"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /tokens/v1/{chainId}/{tokenAddresses}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "solana"
                k: "param"
                n: "chain_id"
                or: "chainId"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
                k: "param"
                n: "token_address"
                or: "tokenAddresses"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/tokens/v1/{chainId}/{tokenAddresses}"
          q: {
            exist: [
              "chain_id"
              "token_address"
            ]
          }
          r: {
            param: {
              chainId: "chain_id"
              tokenAddresses: "token_address"
            }
          }
          s: [
            {
              lit: "tokens"
            }
            {
              lit: "v1"
            }
            {
              var: "chain_id"
            }
            {
              var: "token_address"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
